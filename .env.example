# Copy to .env when a backend exists. Key NAMES only here, never values.
# Stripe keys belong to Matt's own Stripe account and go through the secure
# vault / Vercel environment variables, never into the repo.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Printful API key, phase 2 backend only.
PRINTFUL_API_KEY=
# Matt's Instagram handle, no @ sign.
INSTAGRAM_HANDLE=
